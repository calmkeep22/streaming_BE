{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\"}",
        "name": "Firing alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count[1m]))", "legendFormat": "requests/s", "refId": "A"}],
      "title": "HTTP request rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}, "unit": "percent"}},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "targets": [{"expr": "100 * sum(rate(http_server_requests_seconds_count{status=\"503\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])), 0.001)", "legendFormat": "503 ratio", "refId": "A"}],
      "title": "HTTP 503 ratio",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 0.5}, {"color": "red", "value": 1}]}, "unit": "s"}},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}],
      "title": "HTTP latency p95",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 2}]}}},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "targets": [{"expr": "sum(up{job=\"redis-sentinel\"})", "legendFormat": "available", "refId": "A"}],
      "title": "Available Sentinels (quorum=2)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 5,
      "targets": [{"expr": "sum by (operation, result) (rate(seat_hold_redis_operations_total[1m]))", "legendFormat": "{{operation}} / {{result}}", "refId": "A"}],
      "title": "Seat hold Redis operations",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 6,
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, operation) (rate(seat_hold_redis_duration_seconds_bucket[5m])))", "legendFormat": "{{operation}} p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, operation) (rate(seat_hold_redis_duration_seconds_bucket[5m])))", "legendFormat": "{{operation}} p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le, operation) (rate(seat_hold_redis_duration_seconds_bucket[5m])))", "legendFormat": "{{operation}} p99", "refId": "C"}
      ],
      "title": "Seat hold Redis latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 13},
      "id": 7,
      "targets": [{"expr": "100 * redis_memory_used_bytes{job=\"redis-data\"} / clamp_min(redis_memory_max_bytes{job=\"redis-data\"}, 1)", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Redis memory usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 13},
      "id": 8,
      "targets": [{"expr": "redis_connected_clients{job=\"redis-data\"}", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Redis connected clients",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 13},
      "id": 9,
      "targets": [{"expr": "redis_connected_slave_lag_seconds{job=\"redis-data\"}", "legendFormat": "{{instance}} -> {{slave_ip}}", "refId": "A"}],
      "title": "Redis replication lag",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 21},
      "id": 10,
      "targets": [{"expr": "increase(redis_evicted_keys_total{job=\"redis-data\"}[5m])", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Evicted keys (5m)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 21},
      "id": 11,
      "targets": [{"expr": "sum(jvm_memory_used_bytes) by (area)", "legendFormat": "{{area}}", "refId": "A"}],
      "title": "JVM memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 21},
      "id": 12,
      "targets": [
        {"expr": "hikaricp_connections_active", "legendFormat": "active", "refId": "A"},
        {"expr": "hikaricp_connections_pending", "legendFormat": "pending", "refId": "B"},
        {"expr": "hikaricp_connections_idle", "legendFormat": "idle", "refId": "C"}
      ],
      "title": "HikariCP connections",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"align": "auto"}}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "id": 13,
      "options": {"showHeader": true},
      "targets": [{"expr": "up{job=~\"streaming-app|redis-data|redis-sentinel\"}", "format": "table", "instant": true, "refId": "A"}],
      "title": "Scrape target status",
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"align": "auto"}}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "id": 14,
      "options": {"showHeader": true},
      "targets": [{"expr": "ALERTS{alertstate=\"firing\"}", "format": "table", "instant": true, "refId": "A"}],
      "title": "Firing alerts",
      "type": "table"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["streaming", "redis", "sentinel"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "browser",
  "title": "Streaming Redis & Sentinel Observability",
  "uid": "streaming-redis-observability",
  "version": 1
}
