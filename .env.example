DB_PASSWORD=
DB_USERNAME=root
# base64로 인코딩한 32바이트 이상 키 (예: openssl rand -base64 32)
JWT_SECRET=

# 결제사 구현체: fake(기본) 또는 toss
PAYMENT_GATEWAY=fake
# 토스페이먼츠 개발자센터의 테스트 키 (test_ck, test_sk). 실제 값은 .env에만 둔다
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_SECURITY_KEY=

# node loadtest/current-suite.mjs recreates this dedicated schema.
LOADTEST_DB_NAME=streaming_loadtest
LOADTEST_REDIS_DATABASE=15

# Docker Compose Sentinel 실험용. 운영 환경에서는 반드시 별도 비밀값을 사용한다.
REDIS_PASSWORD=streaming-redis-dev
REDIS_SENTINEL_PASSWORD=streaming-sentinel-dev
MYSQL_PASSWORD=streaming-mysql-dev
MYSQL_ROOT_PASSWORD=streaming-root-dev
