# Copy to /opt/streaming/shared/backend.env on the backend VM.
# Generate independent random hexadecimal passwords. Never commit the real file.
# Managed MySQL: use a private endpoint and a dedicated application account.
DB_URL=jdbc:mysql://10.0.1.10:3306/streaming?sslMode=REQUIRED&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=streaming_app
DB_PASSWORD=replace-with-database-password
REDIS_PASSWORD=replace-with-random-hex
REDIS_SENTINEL_PASSWORD=replace-with-another-random-hex
# openssl rand -base64 32
JWT_SECRET=replace-with-base64-32-byte-key
PAYMENT_GATEWAY=fake
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
MEDIA_ENABLED=false
MEDIA_CALLBACK_BIND_IP=127.0.0.1
# Configure once with deploy/configure-media-auth.py before enabling in production.
MEDIA_TOKEN_SECRET=
MEDIA_PUBLISHER_PASSWORD_HASH=
MEDIA_MONITOR_PASSWORD_HASH=
MEDIA_TICKET_TTL=PT2M
